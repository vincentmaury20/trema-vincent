{# templates/page/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
  {% if page %}
    <section class="page-content container">
      <div class="page-left-part">
        <h1>{{ page.title }}</h1>
        {% if page.subtitle %}
          <h2>{{ page.subtitle|raw }}</h2>
        {% endif %}
        {% if page.image %}
          <img src="{{ asset('uploads/images/' ~ page.image) }}" alt="{{ page.title }}" class="image-page"/>
        {% endif %}
      </div>

      <div class="content">
        {{ page.content|raw }}
      </div>
    </section>
  {% else %}
    <div class="empty-message container">
      <p>Cette page est vide pour le moment.</p>
    </div>
  {% endif %}
{% endblock %}


{% block stylesheets %}
{{ parent() }}

<style>
.page-content {
    display: flex;
    padding: 1rem;
}
.page-left-part {
    width: 40%;
}
.content {
    width: 60%;
    text-align: justify;
    background: linear-gradient(0deg, #9cc6db 0%, #ffffff 100%);
    padding: 2rem;
    border-radius: 1rem;
}

.image-page {
    width: 90%;
    border-radius: 10px;
    margin: 2rem 0rem;
}
</style>

{% endblock %}
