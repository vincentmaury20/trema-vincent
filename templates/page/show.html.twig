{% extends 'base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
{% if page %}
    {{ page.subtitle|raw }}
    {{ page.content|raw }}

{% if page.image %}
    <img src="/uploads/images/{{ page.image }}" alt="{{ page.title }}" class="img-fluid my-4"/>
{% endif %}
{% else %}
    <div class="empty-message">
        <p>Cette page est vide pour le moment.</p>
    </div>
{% endif %}
{% endblock %}