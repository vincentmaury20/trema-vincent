{# templates/page/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
  {% if page %}
    <section class="page-content container">
      <h1>{{ page.title }}</h1>

      {% if page.subtitle %}
        <h2>{{ page.subtitle|raw }}</h2>
      {% endif %}

      {% if page.image %}
        <img src="{{ asset('uploads/images/' ~ page.image) }}" alt="{{ page.title }}" class="img-fluid my-4"/>
      {% endif %}

      <div class="content">
        {{ page.content|raw }}
      </div>
    </section>
  {% else %}
    <div class="empty-message container">
      <p>Cette page est vide pour le moment.</p>
    </div>
  {% endif %}
{% endblock %}
