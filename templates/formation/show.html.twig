{% extends 'base.html.twig' %}


{% block body %}

<main class= "about-formation">
  
    {# Ici c'est la carte de visite ... #}
        <section class="formation-left-part">
          <h2 class="left-part-title">Me contacter</h2>
          <div class="left-part-image">
            <img src="{{ asset('images/photo.avif') }}" alt="Photo de Catia Tuccinardi Gouyette" class="left-part-image" />
          </div>
          <h3 class="left-part-subtitle">Catia Tuccinardi Gouyette</h3>
          <p>Vous vous posez des questions ? Soyons pragmatiques, je vous répondrai simplement.</p>
          <ul class="left-part-list">
            <li><i class="bi bi-phone-fill"> </i> 06 86 62 98 14</li>
            <li><i class="bi bi-envelope-fill"> </i> contact@trema-coach.com</li>
            <li><i class="bi bi-geo-alt-fill"> </i> 97 bis rue Jouffroy d'Abbans 75017 PARIS</li>
           <li><a class="button-56" role= "button" onclick="location.href='{{ path('app_contact') }}'">Prendre contact</a></li>
          </ul>
        </section>
        {# Ici c'est la carte de visite ... #}
  
  
        {# Ici c'est lé détail de la formation ... #}
        {%if formation is not empty %}
           <div class="page-container ">
              {% for item in formation %}
                 <div class="formation-item">
                    <h1 class= "formation-title" >{{ item.title }}</h1>
                    <p class="formation-content" > {{ item.content }}</p>
                 </div>

                 <div class= "page-container-button">
                   <button class="button-56" role= "button" onclick="location.href='{{ path('app_formation') }}'">Retour à la liste des formations</button>
                   <button class="button-56" role= "button" onclick="location.href='{{ path('app_home') }}'">Retour à l'accueil</button>
                 </div>

              {% endfor %}
           </div>
        {% endif %}
  
        {% if formation is empty %}
           <div class="empty-message">
              <p>Aucune formation disponible pour le moment.</p>
           </div>
      {% endif %}
    {# Ici c'est lé détail de la formation ... #}
</main>



{% endblock %}

{% block stylesheets %}
{{parent()}}
<style>

.about-formation {
    display: flex;
    padding: 2rem;
    gap: 2rem;
}

.formation-left-part {
    width: 25%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1rem;
    gap: 1rem;
}

.formation-left-part img {
    width: 80%;
    border-radius: 10px;
    box-shadow: 0px 0px 10px 2px rgba(0, 0, 0, 0.45);
}
.left-part-list {
    list-style-type: none;
}
.left-part-list li {
    margin-bottom: 0.5rem;
}
.page-container {
    padding: 1rem;
    max-height: fit-content;
    border-radius: 10px;
}

.page-container-button {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    margin-top: 3rem;
}

.button-56 {
    align-items: center;
    background-color: #a1e2ef;
    border: 2px solid #111;
    border-radius: 8px;
    box-sizing: border-box;
    color: #111;
    cursor: pointer;
    display: flex;
    font-family: Inter, sans-serif;
    font-size: 16px;
    height: 48px;
    justify-content: center;
    line-height: 24px;
    max-width: 100%;
    padding: 0 25px;
    position: relative;
    text-align: center;
    text-decoration: none;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
}

.button-56:after {
    background-color: #111;
    border-radius: 8px;
    content: "";
    display: block;
    height: 48px;
    left: 0;
    width: 100%;
    position: absolute;
    top: -2px;
    transform: translate(8px, 8px);
    transition: transform 0.2s ease-out;
    z-index: -1;
}

.button-56:hover:after {
    transform: translate(0, 0);
}

.button-56:active {
    background-color: #0dcaf0;
    outline: 0;
}

.button-56:hover {
    outline: 0;
}

@media (min-width: 768px) {
    .button-56 {
        padding: 0 40px;
    }
}


</style>

{% endblock %}