{% extends 'base.html.twig' %}

{% block title %}Formulaire de contact{% endblock %}

{% block body %}
<div class="container mt-5">
  <div class="row justify-content-center align-items-center">

    <!-- Colonne image -->
    <div class="col-md-6 text-center">
      <img src="{{ asset('images/mailbox.jpg') }}" alt="Boîte aux lettres" class="rounded img-fluid shadow-sm image-contact" />
    </div>

    <!-- Colonne formulaire -->
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title mb-4">Contactez-moi</h5>

          {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

          <div class="mb-3">
            {{ form_row(form.gender, {'attr': {'class': 'form-select'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.lastName, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.firstName, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.phone, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.message, {'attr': {'class': 'form-control', 'rows': '5'}}) }}
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-primary">Envoyer</button>
          </div>

          {{ form_end(form) }}
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  body {
    background: linear-gradient(to right, #f8f9fa, #e9ecef);
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }

  .container {
    padding-bottom: 4rem;
  }

  .card {
    border: none;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    background-color: #ffffff;
  }

  .card-title {
    font-weight: 600;
    color: #343a40;
    text-align: center;
  }

  .form-control,
  .form-select {
    border-radius: 8px;
    border: 1px solid #ced4da;
    transition: border-color 0.3s ease;
  }

  .form-control:focus,
  .form-select:focus {
    border-color: #007bff;
    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
  }

  .btn-primary {
    background-color: #007bff;
    border: none;
    border-radius: 8px;
    padding: 0.75rem;
    font-weight: 600;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #0056b3;
    transform: translateY(-2px);
  }

  .image-contact {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .row.align-items-center {
      flex-direction: column-reverse;
    }

    .card {
      margin-top: 2rem;
    }
  }
</style>
{% endblock %}