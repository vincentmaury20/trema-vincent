{% extends 'base.html.twig' %}

{% block title %}Formulaire de contact{% endblock %}

{% block body %}
<div class="container mt-5">
  <div class="row justify-content-center align-items-center">

    <!-- Colonne image -->
    <div class="col-md-6 text-center">
      <img src="{{ asset('images/mailbox.jpg') }}" alt="Boîte aux lettres" class="rounded img-fluid shadow-sm image-contact" />
    </div>

    <!-- Colonne formulaire -->
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-body">
          <h5 class="card-title mb-4">Contactez-nous</h5>

          {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

          <div class="mb-3">
            {{ form_row(form.gender, {'attr': {'class': 'form-select'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.lastName, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.firstName, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.phone, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.email, {'attr': {'class': 'form-control'}}) }}
          </div>
          <div class="mb-3">
            {{ form_row(form.message, {'attr': {'class': 'form-control', 'rows': '5'}}) }}
          </div>

          <div class="d-grid">
            <button type="submit" class="btn btn-primary">Envoyer</button>
          </div>

          {{ form_end(form) }}
        </div>
      </div>
    </div>

  </div>
</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  .card {
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  }
  .btn-primary {
    background-color: #007bff;
    border-color: #007bff;
  }
  .btn-primary:hover {
    background-color: #0056b3;
    border-color: #0056b3;
  }
  .image-contact {
    max-width: 100%;
    height: auto;
  }
</style>
{% endblock %}