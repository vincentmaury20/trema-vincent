<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-brand" onclick="location.href='{{ path('app_home') }}'" style="cursor:pointer;">
      <h2 class="brand mb-0">
        Tréma <i class="bi bi-circle-fill text-info"></i><i class="bi bi-circle-fill text-info"></i>
      </h2>
    </div>

    <nav class="footer-nav">
      <div class="footer-social-links">
        <a href="https://instagram.com/" aria-label="Instagram" target="_blank" rel="noopener">
          <i class="bi bi-instagram"></i>
        </a>
        <a href="https://www.linkedin.com/" aria-label="LinkedIn" target="_blank" rel="noopener">
          <i class="bi bi-linkedin"></i>
        </a>
        <a href="https://www.facebook.com/" aria-label="Facebook" target="_blank" rel="noopener">
          <i class="bi bi-facebook"></i>
        </a>
      </div>
    </nav>

    <p class="footer-copy">&copy; {{ "now"|date('Y') }} Tréma Coaching. Tous droits réservés.</p>
  </div>
</footer>

{% block stylesheets %}

<style>
.site-footer {
  background-color: #1a1a1a;
  color: #f0f0f0;
  padding: 2rem 1rem;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  max-width: 1200px;
  margin: 0 auto;
}

.footer-brand h2 {
  font-size: 1.5rem;
  margin: 0;
  color: #f0f0f0;
}

.footer-social-links a {
  margin: 0 0.5rem;
  color: #f0f0f0;
  font-size: 1.5rem;
  transition: color 0.3s ease;
}

.footer-social-links a:hover {
  color: #00bcd4;
}

.footer-copy {
  font-size: 0.9rem;
  color: #aaa;
}
</style>
{% endblock %}