<header class="site-header border-bottom py-3"
        style="background-image: url('{{ asset('images/background-pro.png') }}'); background-size: cover; background-position: center;">
  <div class="container">
    <div class="row align-items-center">
      <div class="col title-header">
        <h1 class="brand mb-0" onclick="location.href='{{ path('app_home') }}'" style="cursor:pointer;">
          Tréma <i class="bi bi-circle-fill text-info"></i><i class="bi bi-circle-fill text-info"></i>
        </h1>
        <h2 class="lead text-muted">Coaching professionnel</h2>
      </div>

      <div class="col text-end">
        <div class="dropdown">
          <button type="button" class=" btn btn-outline-primary " onclick="location.href='{{ path('app_formation') }}'">Formations</button>
          <button type="button" class=" btn btn-outline-primary " onclick="location.href='{{ path('app_contact') }}'">Contact</button>
          <button type="button" class="btn btn-dark dropdown-toggle px-4" type="button" id="menuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
            Menu
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="menuDropdown" style="min-width: 220px;">
            <li><a class="dropdown-item {% if app.request.attributes.get('_route') == 'app_testimony' %}active{% endif %}" href="{{ path('app_testimony') }}">Témoignages</a></li>
            <li><a class="dropdown-item {% if app.request.attributes.get('_route') == 'app_testimony_new' %}active{% endif %}" href="{{ path('app_testimony_new') }}">Déposer un témoignage</a></li>

            {% for page in menu_pages() %}
              <li>
                <a class="dropdown-item {% if app.request.get('slug') == page.slug %}active{% endif %}"
                   href="{{ path('app_page_show', { slug: page.slug }) }}">
                  {{ page.title }}
                </a>
              </li>
            {% endfor %}

            {% if is_granted('ROLE_ADMIN') %}
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="{{ path('admin') }}">Admin</a></li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>

{% block stylesheets %}
<style>
  .site-header {
    height: 8rem;
  }

  
</style>
{% endblock %}